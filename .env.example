# ==============================================================================
# PyLaunchpad Environment Configuration
# ==============================================================================

# Application Environment (development / production / testing)
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security (Required for JWT and cookie signing; generate 32+ bytes in production)
SECRET_KEY=replace_this_with_a_cryptographically_secure_random_string

# Database Connection (SQLite default for instant zero-setup; PostgreSQL ready)
# Local SQLite: sqlite:///./pylaunchpad.db
# PostgreSQL: postgresql://username:password@localhost:5432/pylaunchpad_db
DATABASE_URL=sqlite:///./pylaunchpad.db

# Polar.sh Merchant of Record Billing (https://polar.sh)
# Set to 'sandbox' for test checkouts, 'production' for live payments
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=polar_at_your_access_token_here
POLAR_ORGANIZATION_ID=your_organization_id_here
POLAR_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Rate Limiting (Default requests per minute for developer API keys)
DEFAULT_RATE_LIMIT_PER_MINUTE=60
